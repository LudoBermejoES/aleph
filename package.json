{
  "name": "aleph",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky || true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "start-server-and-test 'npx nuxt dev --port 3333' http://localhost:3333 'vitest run tests/integration/'",
    "test:e2e": "playwright test",
    "test:all": "start-server-and-test 'npx nuxt dev --port 3333' http://localhost:3333 'npm run test:unit && npm run test:integration && npm run test:e2e'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "start:prod": "pm2-runtime ecosystem.config.cjs --env production",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs aleph",
    "aleph": "node cli/bin/aleph.js"
  },
