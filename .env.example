# ──────────────────────────────────────────────
# Aleph — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Auth (required)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3333

# Server
NODE_ENV=development
NITRO_PORT=3333
NITRO_HOST=0.0.0.0
LOG_LEVEL=debug

# Database (SQLite — stored at data/aleph.db by convention, no URL needed)
# DATABASE_URL=file:./data/aleph.db

# One-time index backfills on boot (server/plugins/watcher.ts).
# LEAVE THIS UNSET IN PRODUCTION — the backfills are how an index that predates a feature
# ever gets populated. `false` is a LOCAL escape hatch: on a database with thousands of
# entities still pending an embedding, the backfill is awaited before Nitro serves its first
# request, so `nuxt dev` (and `npm run test:integration`, which waits for it) can sit
# unavailable for minutes. Skipping it changes no data and no schema; the indexes simply stay
# as incomplete as they already were. Only the exact string `false` disables it.
# STARTUP_BACKFILLS_ENABLED=false

# Hocuspocus real-time collaboration server
NUXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:3334

# Diagram multiplayer (real-time sync via @tldraw/sync)
NUXT_PUBLIC_DIAGRAM_MULTIPLAYER=false

# Sentry error tracking (optional — error tracking disabled if unset)
# Create a project at https://sentry.io → Settings → Projects → javascript-nuxt
# NUXT_PUBLIC_SENTRY_DSN: the project DSN (safe to commit — intentionally public)
NUXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN: auth token for source map upload at build time (CI only — never commit)
# Create at https://sentry.io → Settings → Auth Tokens with project:releases + org:ci scopes
SENTRY_AUTH_TOKEN=

# Daily backup to Cloudflare R2 (optional — backup is disabled if unset)
# Create an R2 bucket and API token at https://dash.cloudflare.com → R2
NUXT_BACKUP_R2_ENDPOINT=
NUXT_BACKUP_R2_ACCESS_KEY_ID=
NUXT_BACKUP_R2_SECRET_ACCESS_KEY=
NUXT_BACKUP_R2_BUCKET=

# AI summary generation (optional — feature is disabled if unset)
# AI_PROVIDER: "claude" or "openai"
AI_PROVIDER=
# AI_API_KEY: your Anthropic or OpenAI API key
AI_API_KEY=
# AI_MODEL: defaults to claude-sonnet-4-20250514 (Claude) or gpt-4o (OpenAI)
AI_MODEL=

# Where the SQLite file lives. UNSET means the real database (`data/aleph.db`) -- that is what
# production and `npm run dev` use, and what you want. The test scripts set it to a throwaway file
# under the OS temp dir so the suites stop writing into your development database.
# ALEPH_DB_PATH=/tmp/aleph-testdb/aleph.db
