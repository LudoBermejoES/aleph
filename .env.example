# =============================================================================
# Aleph — TTRPG Campaign Manager — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.

# ─── Auth (better-auth) ──────────────────────────────────────────────────────
# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Base URL of the application (used by better-auth for callbacks)
BETTER_AUTH_URL=http://localhost:3000

# ─── Server ──────────────────────────────────────────────────────────────────
# Port and host for the Nitro server
NITRO_PORT=3000
NITRO_HOST=0.0.0.0

# ─── Public (exposed to frontend via runtimeConfig.public) ───────────────────
# Hocuspocus WebSocket URL for collaborative editing
# In production, set to your server's WebSocket endpoint.
# With the nginx /collab proxy block: wss://aleph.ludobermejo.es/collab
# Direct port (if 3334 is open): wss://aleph.ludobermejo.es:3334
# Local dev default:
NUXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:3334

# ─── Logging ─────────────────────────────────────────────────────────────────
# Log level: debug, info, warn, error (default: debug in dev, info in production)
# LOG_LEVEL=info
