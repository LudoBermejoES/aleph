# ──────────────────────────────────────────────
# Aleph — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Auth (required)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3333

# Server
NODE_ENV=development
NITRO_PORT=3333
NITRO_HOST=0.0.0.0
LOG_LEVEL=debug

# Database (SQLite — stored at data/aleph.db by convention, no URL needed)
# DATABASE_URL=file:./data/aleph.db

# Hocuspocus real-time collaboration server
NUXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:3334

# Diagram multiplayer (real-time sync via @tldraw/sync)
NUXT_PUBLIC_DIAGRAM_MULTIPLAYER=false

# Daily backup to Cloudflare R2 (optional — backup is disabled if unset)
# Create an R2 bucket and API token at https://dash.cloudflare.com → R2
NUXT_BACKUP_R2_ENDPOINT=
NUXT_BACKUP_R2_ACCESS_KEY_ID=
NUXT_BACKUP_R2_SECRET_ACCESS_KEY=
NUXT_BACKUP_R2_BUCKET=

# AI summary generation (optional — feature is disabled if unset)
# AI_PROVIDER: "claude" or "openai"
AI_PROVIDER=
# AI_API_KEY: your Anthropic or OpenAI API key
AI_API_KEY=
# AI_MODEL: defaults to claude-sonnet-4-20250514 (Claude) or gpt-4o (OpenAI)
AI_MODEL=
